<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.MenuController" alignment="CENTER" spacing="10">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Button text="Pokreni aplikaciju (unos rezervacija, pretraga...)" onAction="#runApplicationLogic"/>
        <Button text="Dodaj novog zaposlenika" onAction="#addNewEmployee"/>
        <Button text="Dodaj klijenta" onAction="#addClient"/>
        <Button text="Dodaj automobil" onAction="#addCar"/>
        <Button text="Pretraživanje" onAction="#openSearch"/>
        <Button text="Kreiraj pričuvnu kopiju (Backup)" onAction="#backupData"/>
        <Button text="Vrati podatke iz pričuvne kopije (Restore)" onAction="#restoreData"/>
        <Button text="Prikaži zapisnik akcija (XML Log)" onAction="#showLogs"/>
        <Button text="Spremi i izađi" onAction="#saveAndExit"/>
    </children>
</VBox>
